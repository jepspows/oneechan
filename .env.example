# Copy this file to `.env` and fill in the keys for the providers you use.
# Never commit the real `.env` to git.

# --- AI provider keys (any one is enough; the brain uses llm.provider) ---
DEEPSEEK_API_KEY=*** https://platform.deepseek.com
OPENAI_API_KEY=*** https://platform.openai.com
ANTHROPIC_API_KEY=*** https://console.anthropic.com   (Claude)
GEMINI_API_KEY=*** https://aistudio.google.com
OPENROUTER_API_KEY=*** https://openrouter.ai
GROQ_API_KEY=*** https://console.groq.com
XAI_API_KEY=*** https://console.x.ai
TOGETHER_API_KEY=*** https://api.together.xyz
MISTRAL_API_KEY=*** https://console.mistral.ai
PERPLEXITY_API_KEY=*** https://www.perplexity.ai
CO_API_KEY=*** https://dashboard.cohere.com
FIREWORKS_API_KEY=*** https://fireworks.ai
CEREBRAS_API_KEY=*** https://cloud.cerebras.ai
DASHSCOPE_API_KEY=*** https://bailian.console.aliyun.com   (Qwen)

# Hyperliquid wallet private key (hex). ONLY required for live mode.
# Paper mode needs no key at all. Use an API wallet
# (https://app.hyperliquid.xyz/API) — it can trade but never withdraw.
HYPERLIQUID_PRIVATE_KEY=

# --- Multi-agent team (optional) ---------------------------------
# With agent.team_enabled: true the agent runs a team of specialists (market
# analyst, flow analyst, advisor, risk manager) plus a Lead Portfolio Manager.
# They all use the same llm.provider above — no extra keys needed.
# Set team.roles: [] in config.yaml for a single-brain desk.
